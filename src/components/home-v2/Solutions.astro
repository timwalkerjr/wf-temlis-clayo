<section id="solutions" class="bg-background">
  <div class="max-w-[1176px] mx-auto px-6 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] gap-[64px] items-center">
      <!-- Left: Solutions list -->
      <div class="flex flex-col gap-6">
        <div class="bg-[#f3f4f2] p-8 rounded-[20px]">
          <h3 class="text-[24px] font-normal leading-[1.2] text-[#131313] mb-3">Technology solutions</h3>
          <p class="text-[16px] text-[#4e4e4e]">Innovative tech strategies to enhance operational efficiency.</p>
        </div>
        <div class="bg-[#f3f4f2] p-8 rounded-[20px]">
          <h3 class="text-[24px] font-normal leading-[1.2] text-[#131313] mb-3">Risk Management</h3>
          <p class="text-[16px] text-[#4e4e4e]">Identify, assess, and mitigate risks to protect your assets</p>
        </div>
      </div>
      <!-- Right: Image -->
      <div class="rounded-[20px] overflow-hidden">
        <img
          src="https://cdn.prod.website-files.com/6a3c3ed1c7bf81e0610b0b6a/6a3c3ed5c7bf81e0610b0dfc_Expertise%20-%20image.webp"
