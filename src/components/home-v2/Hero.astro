---
---
<section id="hero" class="bg-background">
  <div class="max-w-[1176px] mx-auto px-6 py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-[64px] items-center">
      <!-- Left: Content -->
      <div class="lg:col-span-6 flex flex-col">
        <h1 class="text-[68px] font-normal leading-[1.1] tracking-[-4.08px] text-[#131313]">Empowering finance, elevating success</h1>
        <p class="text-[16px] text-[#4e4e4e] mt-4 mb-8 max-w-[480px]">Easily adapt to changes and scale your operations with our flexible infrastructure, designed to support your business growth.</p>
        <a href="https://www.temlis.com/" class="bg-[#131313] hover:bg-[#232323] text-white rounded-[12px] px-6 py-3 self-start transition-colors">Get Started</a>

        <div class="flex items-center gap-3 mt-12">
          <div class="flex items-center -space-x-3">
            <img src="https://cdn.prod.website-files.com/6a3c3ed1c7bf81e0610b0b6a/6a3c3ed5c7bf81e0610b0da7_hero%20one%20-%20image%20one.webp" alt="Member" class="w-12 h-12 rounded-full border-2 border-white object-cover" />
            <img src="https://cdn.prod.website-files.com/6a3c3ed1c7bf81e0610b0b6a/6a3c3ed5c7bf81e0610b0da8_hero%20one%20-%20image%20two.webp" alt="Member" class="w-12 h-12 rounded-full border-2 border-white object-cover" />
            <img src="https://cdn.prod.website-files.com/6a3c3ed1c7bf81e0610b0b6a/6a3c3ed5c7bf81e0610b0da9_hero%20one%20-%20image%20three.webp" alt="Member" class="w-12 h-12 rounded-full border-2 border-white object-cover" />
          </div>
          <div class="flex flex-col">
            <span class="text-[16px] font-medium text-[#131313]">10K+</span>
            <span class="text-[14px] text-[#4e4e4e]">10.000+ people already joined the Clayo</span>
          </div>
        </div>
      </div>

      <!-- Right: Image + overlay -->
      <div class="lg:col-span-6">
        <div class="relative rounded-[24px] overflow-hidden">
          <img
            src="https://cdn.prod.website-files.com/6a3c3ed1c7bf81e0610b0b6a/6a3c3ed5c7bf81e0610b0de0_hero%20two%20-%20main%20image.webp"
            alt="Hero"
            class="w-full h-auto object-cover"
          />
          <div class="absolute bottom-6 left-6 bg-white p-6 rounded-[20px] shadow-lg w-[240px]">
            <img
              src="https://cdn.prod.website-files.com/6a3c3ed1c7bf81e0610b0b6a/6a3c3ed5c7bf81e0610b0dc2_hero%20one%20-%20balance.webp"
              alt="Balance"
              class="w-full h-auto object-cover rounded-[8px]"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
