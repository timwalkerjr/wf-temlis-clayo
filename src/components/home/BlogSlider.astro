---
import Container from '@/components/Container.astro';

const posts = [
  {
    title: 'The Ultimate Guide to Budgeting in 2024',
    excerpt: 'Master the art of budgeting with our comprehensive guide. Learn how to create a budget that works for you.',
    image: 'https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0d00_Blog-one-thumbnail-image-320.webp',
    tags: ['News', 'Insights'],
    href: '/blogs/the-ultimate-guide-to-budgeting-in-2024'
  },
  {
    title: 'Top Investment Strategies for Long-Term Growth',
    excerpt: 'Discover the best investment strategies to build and sustain your wealth over time. From stocks to bonds.',
    image: 'https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0d04_Blog-two-thumbnail-image-640.webp',
    tags: ['News', 'Insights'],
    href: '/blogs/top-investment-strategies-for-long-term-growth'
  },
  {
    title: 'Understanding Cryptocurrency: What You Need to Know',
    excerpt: 'Cryptocurrency continues to make headlines, but what does it mean for your finances? Get a clear understanding of the risks.',
    image: 'https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0d06_Blog-three-thumbnail-image-640.webp',
    tags: ['News', 'Insights'],
    href: '/blogs/understanding-cryptocurrency-what-you-need-to-know'
  },
  {
    title: 'How to Reduce Debt and Improve Your Credit Score',
    excerpt: 'Global events can have a significant impact on your finances. Learn how to navigate economic uncertainty.',
    image: 'https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0d09_Blog-four-thumbnail-image-320.webp',
    tags: ['News', 'Insights'],
    href: '/blogs/how-to-reduce-debt-and-improve-your-credit-score'
  },
  {
    title: 'The Impact of Global Events on Your Finances',
    excerpt: 'Global events can have a significant impact on your finances. Learn how to navigate economic uncertainty.',
    image: 'https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0d0c_Blog-five-thumbnail-image-320.webp',
    tags: ['News', 'Insights'],
    href: '/blogs/the-impact-of-global-events-on-your-finances'
  },
  {
    title: 'Financial Planning for Entrepreneurs: A Success Blueprint',
    excerpt: 'Running a business requires careful financial planning. Discover the key steps to managing your business finances.',
    image: 'https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0d71_Blog-six-thumbnail-image-320.webp',
    tags: ['News', 'Insights'],
    href: '/blogs/financial-planning-for-entrepreneurs-a-success-blueprint'
  }
];
---

<section id="blog-slider" class="bg-background py-24" data-ps="src/components/home/BlogSlider.astro:9w5gc0">
  <Container class="max-w-[1176px]">
    <div class="mb-16" data-ps="src/components/home/BlogSlider.astro:ixotrt">
      <div class="flex items-center gap-2 text-[16px] font-normal text-[#131313] mb-4" data-ps="src/components/home/BlogSlider.astro:ixotru">
        <span class="w-2 h-2 rounded-full bg-[#131313]" data-ps="src/components/home/BlogSlider.astro:di1if"></span>
        Blog and articles
      </div>
      <h2 class="text-[60px] font-normal text-[#131313] tracking-[-3.6px] leading-[1.1]" data-ps="src/components/home/BlogSlider.astro:w0328u">
        Latest insights and trends
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-ps="src/components/home/BlogSlider.astro:ixotrv">
      {posts.map(post => (
        <a href={post.href} class="flex flex-col gap-6 no-underline group" data-ps="src/components/home/BlogSlider.astro:b9sw6m">
          <div class="aspect-[1.2] rounded-[20px] overflow-hidden bg-surface" data-ps="src/components/home/BlogSlider.astro:ixotrw">
            <img src={post.image} alt={post.title} class="w-full h-full object-cover transition-transform group-hover:scale-105" data-ps="src/components/home/BlogSlider.astro:axk4vh" />
          </div>
          <div class="flex flex-col gap-4" data-ps="src/components/home/BlogSlider.astro:ixotrx">
            <div class="flex gap-2" data-ps="src/components/home/BlogSlider.astro:ixotry">
              {post.tags.map(tag => (
                <span class="px-3 py-1 bg-[#f3f4f2] rounded-full text-[12px] font-medium text-[#4e4e4e] uppercase tracking-wider" data-ps="src/components/home/BlogSlider.astro:di1ig">{tag}</span>
              ))}
            </div>
            <h3 class="text-[24px] font-normal leading-[1.2] text-[#131313] group-hover:text-secondary transition-colors" data-ps="src/components/home/BlogSlider.astro:h1cr3q">
              {post.title}
            </h3>
            <p class="text-[16px] leading-[1.6] text-[#4e4e4e]" data-ps="src/components/home/BlogSlider.astro:45uzgv">
              {post.excerpt}
            </p>
          </div>
        </a>
      ))}
    </div>

    <!-- Nav Controls (Visual only) -->
    <div class="flex gap-4 mt-12" data-ps="src/components/home/BlogSlider.astro:ixotrz">
      <button class="w-12 h-12 rounded-full bg-[#131313] text-white flex items-center justify-center hover:bg-[#232323] transition-colors" data-ps="src/components/home/BlogSlider.astro:g9ecbo">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
      </button>
      <button class="w-12 h-12 rounded-full bg-[#131313] text-white flex items-center justify-center hover:bg-[#232323] transition-colors" data-ps="src/components/home/BlogSlider.astro:g9ecbp">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </Container>
</section>
