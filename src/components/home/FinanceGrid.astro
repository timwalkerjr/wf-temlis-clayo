---
import Container from '@/components/Container.astro';
---

<section id="finance-grid" class="bg-background py-24" data-ps="src/components/home/FinanceGrid.astro:a1xzwu">
  <Container class="max-w-[1176px]">
    <!-- Header Row -->
    <div class="flex flex-col lg:flex-row justify-between items-start gap-12 mb-16" data-ps="src/components/home/FinanceGrid.astro:ufoc6t">
      <h2 class="text-[60px] font-normal tracking-[-3.6px] leading-[1.1] max-w-[500px] text-[#131313]" data-ps="src/components/home/FinanceGrid.astro:dum1pa">
        Make payment easy, simplify your finance
      </h2>
      <p class="text-[16px] leading-[1.6] text-[#4e4e4e] max-w-[480px] lg:pt-16" data-ps="src/components/home/FinanceGrid.astro:io02dc">
        Our platform managing personal finances or growing your investment portfolio, our system integrates the latest technology to help you make smarter financial decisions with ease.
      </p>
    </div>

    <!-- Metrics Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-ps="src/components/home/FinanceGrid.astro:o80nj1">
      <!-- Col 1 -->
      <div class="flex flex-col gap-6" data-ps="src/components/home/FinanceGrid.astro:o80nj2">
        <div class="rounded-[20px] overflow-hidden bg-surface aspect-[1140/516]" data-ps="src/components/home/FinanceGrid.astro:o80nj3">
          <img src="https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0df9_Frame-2147226953-1024.webp" alt="Finance integration" class="w-full h-full object-cover" data-ps="src/components/home/FinanceGrid.astro:wxxgid" />
        </div>
        <div class="bg-[#5f58ff] p-8 rounded-[20px] text-white flex flex-col gap-4" data-ps="src/components/home/FinanceGrid.astro:o80nj4">
          <span class="text-[48px] font-normal leading-none" data-ps="src/components/home/FinanceGrid.astro:qzndc2">95%</span>
          <p class="text-[16px] leading-relaxed opacity-90" data-ps="src/components/home/FinanceGrid.astro:io02dd">
            Complete customer satisfaction achieved through personalized solutions, proactive support, and a dedication to meeting the unique needs of every client. Our focus on excellence ensures your success at every step.
          </p>
        </div>
      </div>

      <!-- Col 2 -->
      <div class="flex flex-col gap-6" data-ps="src/components/home/FinanceGrid.astro:o80nj5">
        <div class="bg-[#232323] p-8 rounded-[20px] text-white flex flex-col gap-4" data-ps="src/components/home/FinanceGrid.astro:o80nj6">
          <span class="text-[48px] font-normal leading-none text-white" data-ps="src/components/home/FinanceGrid.astro:qzndc3">10+</span>
          <p class="text-[16px] leading-relaxed opacity-70" data-ps="src/components/home/FinanceGrid.astro:io02de">
            Years of innovation and valuable insights, empowering businesses to thrive in a competitive market.
          </p>
        </div>
        <div class="rounded-[20px] overflow-hidden bg-surface aspect-[500/960]" data-ps="src/components/home/FinanceGrid.astro:o80nj7">
          <img src="https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0dfa_Finance-image-three-320.webp" alt="Finance growth" class="w-full h-full object-cover" data-ps="src/components/home/FinanceGrid.astro:wxxgic" />
        </div>
      </div>

      <!-- Col 3 -->
      <div class="bg-[#f3f4f2] p-8 rounded-[20px] flex flex-col justify-between h-full min-h-[480px]" data-ps="src/components/home/FinanceGrid.astro:o80nj8">
        <div class="flex flex-col gap-8" data-ps="src/components/home/FinanceGrid.astro:o80nj9">
           <img src="https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0df8_Frame-2147226954-320.webp" alt="Dashboard metrics" class="w-full rounded-[12px]" data-ps="src/components/home/FinanceGrid.astro:wxxgib" />
           <div class="flex flex-col gap-4" data-ps="src/components/home/FinanceGrid.astro:o80nja">
              <span class="text-[48px] font-normal leading-none text-[#131313]" data-ps="src/components/home/FinanceGrid.astro:qzndc4">95%</span>
              <p class="text-[16px] leading-relaxed text-[#4e4e4e]" data-ps="src/components/home/FinanceGrid.astro:io02df">
                Complete customer satisfaction achieved through personalized solutions, proactive support, and a dedication to meeting the unique needs of every client. Our focus on excellence ensures your success at every step.
              </p>
           </div>
        </div>
      </div>
    </div>
  </Container>
</section>
