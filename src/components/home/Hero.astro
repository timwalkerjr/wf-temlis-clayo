---
import Container from '@/components/Container.astro';
---

<section id="hero" class="bg-background pt-16 pb-24 overflow-hidden" data-ps="src/components/home/Hero.astro:ah8lbl">
  <Container class="max-w-[1176px]">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24 items-center" data-ps="src/components/home/Hero.astro:ecxgf3">
      <!-- Left Content -->
      <div class="lg:col-span-6 flex flex-col items-start hero-animate" data-ps="src/components/home/Hero.astro:ecxgf4">
        <h1 class="text-[68px] leading-[1.1] font-normal tracking-[-4.08px] text-[#131313] mb-6" data-ps="src/components/home/Hero.astro:307k1n">
          Build & growth with scalable tools
        </h1>
        <p class="text-[16px] leading-[1.6] text-[#4e4e4e] mb-10 max-w-[480px]" data-ps="src/components/home/Hero.astro:6uykn4">
          Easily adapt to changes and scale your operations with our flexible infrastructure, designed to support your business growth.
        </p>
        <a href="https://www.temlis.com/" class="btn-primary text-[16px] px-8 py-4 rounded-[12px] mb-16" data-ps="src/components/home/Hero.astro:8zc20">
          Get Started
        </a>

        <!-- Social Proof -->
        <div class="flex items-center gap-4" data-ps="src/components/home/Hero.astro:ecxgf5">
          <div class="flex -space-x-3" data-ps="src/components/home/Hero.astro:ecxgf6">
            <img src="https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0da7_hero-one-image-one-100.webp" alt="" class="w-10 h-10 rounded-full border-2 border-white object-cover" data-ps="src/components/home/Hero.astro:gfvoyw" />
            <img src="https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0da8_hero-one-image-two-100.webp" alt="" class="w-10 h-10 rounded-full border-2 border-white object-cover" data-ps="src/components/home/Hero.astro:gfvoyx" />
            <img src="https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0da9_hero-one-image-three-100.webp" alt="" class="w-10 h-10 rounded-full border-2 border-white object-cover" data-ps="src/components/home/Hero.astro:gfvoyy" />
          </div>
          <div class="flex flex-col" data-ps="src/components/home/Hero.astro:ecxgf7">
            <span class="text-[16px] font-bold text-[#131313] leading-none" data-ps="src/components/home/Hero.astro:z1i1xb">10K+</span>
            <span class="text-[14px] text-[#4e4e4e]" data-ps="src/components/home/Hero.astro:z1i1xa">10.000+ people already joined the Advisory</span>
          </div>
        </div>
      </div>

      <!-- Right Visual -->
      <div class="lg:col-span-6 relative hero-animate hero-animate-delay-1" data-ps="src/components/home/Hero.astro:ecxgf8">
        <div class="rounded-[24px] overflow-hidden bg-surface aspect-[874/1022]" data-ps="src/components/home/Hero.astro:ecxgf9">
          <img 
            src="https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0dc0_hero-one-main-image-768.webp" 
            alt="Build & growth with scalable tools" 
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high" data-ps="src/components/home/Hero.astro:gfvoyz" />
        </div>

        <!-- Float Card -->
        <div class="absolute bottom-6 left-6 bg-white p-6 rounded-[20px] shadow-2xl w-[240px] hero-animate hero-animate-delay-2" data-ps="src/components/home/Hero.astro:ecxgfa">
          <div class="flex flex-col gap-4" data-ps="src/components/home/Hero.astro:ecxgfb">
             <div class="flex flex-col" data-ps="src/components/home/Hero.astro:ecxgfc">
               <span class="text-[12px] text-[#4e4e4e] font-medium uppercase tracking-wider" data-ps="src/components/home/Hero.astro:z1i1wo">Total balance</span>
               <span class="text-[24px] font-bold text-[#131313] mt-1" data-ps="src/components/home/Hero.astro:z1i1wn">$1.204,00</span>
             </div>
             <img src="https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0dc2_hero-one-balance-320.webp" alt="Performance chart" class="w-full rounded-lg" data-ps="src/components/home/Hero.astro:gfvoz0" />
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
