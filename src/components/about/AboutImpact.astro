---
const { image = "https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0df3_Impact-four-main-image-768.webp", text = "We are dedicated to revolutionizing the way individuals and businesses manage their finances. Our team is committed to providing intuitive and innovative solutions that empower our users to achieve financial success.", ctaText = "Get Started", ctaHref = "#" } = Astro.props;
---
<section id="about-impact" class="bg-background">
  <div class="max-w-[1176px] mx-auto px-6 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-[48px] items-center">
      <div class="rounded-[24px] overflow-hidden bg-[#f3f4f2]">
        <img src={image} alt="Impact" class="w-full h-auto object-cover" loading="lazy" />
      </div>
      <div class="flex flex-col gap-6">
        <p class="text-[20px] leading-[1.5] text-foreground max-w-[520px]">{text}</p>
        <a href={ctaHref} class="bg-[#131313] hover:bg-[#232323] text-white rounded-[12px] px-6 py-3 self-start transition-colors">
          {ctaText}
        </a>
      </div>
    </div>
  </div>
</section>
