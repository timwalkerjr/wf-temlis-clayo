---
const { image = "https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0df2_About-two-main-image-320.webp" } = Astro.props;
---
<section id="about-hero" class="bg-background">
  <div class="max-w-[1176px] mx-auto px-6 py-20">
    <div class="rounded-[24px] overflow-hidden bg-[#f3f4f2]">
      <img src={image} alt="About Clayo" class="w-full h-auto object-cover" loading="lazy" />
    </div>
  </div>
</section>
