---
const { label = "About Clayo", text = "We are passionate about empowering individuals and businesses to take control of their finances and achieve their financial goals." } = Astro.props;
---
<section id="about-tagline" class="bg-surface">
  <div class="max-w-[1176px] mx-auto px-6 py-24">
    <div class="grid grid-cols-1 lg:grid-cols-[200px_1fr] gap-[48px] items-start">
      <div class="text-[16px] font-normal text-foreground whitespace-nowrap">• {label}</div>
      <h2 class="text-[36px] font-normal leading-[1.3] tracking-[-2.16px] text-foreground max-w-[900px]">
        {text}
      </h2>
    </div>
  </div>
</section>
