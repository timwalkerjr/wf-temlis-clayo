---
const { ctaText = "Get Started", ctaHref = "#", image = "https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0df4_About-three-main-image-1536.webp" } = Astro.props;
---
<section id="about-hero" class="bg-background">
  <div class="max-w-[1176px] mx-auto px-6 py-12 flex flex-col gap-12">
    <div class="flex justify-end">
      <a href={ctaHref} class="bg-[#131313] hover:bg-[#232323] text-white rounded-[12px] px-6 py-3 transition-colors inline-block">
        {ctaText}
      </a>
    </div>
    <div class="rounded-[24px] overflow-hidden bg-[#f3f4f2]">
      <img src={image} alt="About Clayo" class="w-full h-auto object-cover" loading="lazy" />
    </div>
  </div>
</section>
