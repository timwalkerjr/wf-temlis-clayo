---
const testimonials = [
  { quote: "Clayo has revolutionized how I manage my startup's finances. The platform is intuitive and the insights are incredibly valuable. I can't imagine going back to how we used to do things.", author: "Sarah Thompson", role: "Founder, GreenPath Solutions", img: "https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0dce_Testimonials-use-one-144.webp" },
  { quote: "Thanks to Clayo, our team has gained better visibility into our budget and spending trends. The automation features save us hours every week, and the platform just keeps getting better.", author: "David Wilson", role: "CFO, Nova Enterprises", img: "https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0ddd_Testimonials-use-three-144.webp" },
  { quote: "I've used several financial platforms before, but none as complete and user-friendly as Clayo. It's helped me grow my freelance business with confidence and clarity.", author: "Emily Harris", role: "Freelance Consultant, EH Strategies", img: "https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0dcf_Testimonials-use-two-144.webp" },
  { quote: "Clayo delivers exactly what modern businesses need — simplicity, power, and reliability. Our financial operations are smoother than ever.", author: "James O'Connor", role: "Managing Director, BrightCore Ltd", img: "https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0dd0_Testimonials-use-four-144.webp" },
  { quote: "Clayo gives me peace of mind. Tracking expenses and setting financial goals has never been easier. The design is clean, and everything just works.", author: "Olivia Bennett", role: "Marketing Director, Horizon Brands", img: "https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0de2_Testimonials-use-five-144.webp" },
  { quote: "As a small business owner, Clayo has been a lifesaver. It's like having a full finance team in one app. Highly recommend it to anyone looking to scale smartly.", author: "Michael Reed", role: "Owner, Reed & Co.", img: "https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0de3_Testimonials-use-six-144.webp" },
];
---
<section id="testimonials" class="bg-surface">
  <div class="max-w-[1176px] mx-auto px-6 py-24 text-center">
    <div class="text-[16px] font-medium uppercase tracking-wider text-[#4e4e4e] mb-12">• Testimonials</div>
    <div class="relative">
      <div id="testimonial-track" class="overflow-hidden">
        <div id="testimonial-slides" class="flex transition-transform duration-500 ease-out">
          {testimonials.map((t) => (
            <div class="w-full flex-shrink-0 px-4">
              <p class="text-[32px] leading-[1.4] font-normal max-w-[900px] mx-auto text-[#131313] mb-8">"{t.quote}"</p>
              <div class="flex flex-col items-center gap-3">
                <div class="w-16 h-16 rounded-full overflow-hidden border-2 border-white shadow">
                  <img src={t.img} alt={t.author} class="w-full h-full object-cover" loading="lazy" />
                </div>
                <div>
                  <div class="text-[16px] font-normal text-[#131313]">{t.author}</div>
                  <div class="text-[14px] text-[#4e4e4e] mt-1">{t.role}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="flex items-center justify-center gap-2 mt-12" id="testimonial-dots">
        {testimonials.map((_, i) => (
          <button class={`w-2 h-2 rounded-full transition-colors ${i === 0 ? 'bg-[#131313]' : 'bg-[#d4d4d4]'}`} data-index={i} aria-label={`Go to slide ${i + 1}`}></button>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const slides = document.getElementById('testimonial-slides');
    const dots = document.querySelectorAll('#testimonial-dots button');
    if (!slides || dots.length === 0) return;
    let idx = 0;
    const total = dots.length;
    function go(i) {
      idx = (i + total) % total;
      slides.style.transform = `translateX(-${idx * 100}%)`;
      dots.forEach((d, j) => {
        d.classList.toggle('bg-[#131313]', j === idx);
        d.classList.toggle('bg-[#d4d4d4]', j !== idx);
      });
    }
    dots.forEach((d, j) => d.addEventListener('click', () => go(j)));
    let timer = setInterval(() => go(idx + 1), 5000);
    const container = slides.parentElement.parentElement;
    container.addEventListener('mouseenter', () => clearInterval(timer));
    container.addEventListener('mouseleave', () => { timer = setInterval(() => go(idx + 1), 5000); });
  })();
</script>
