---
<section id="dashboard-features" class="bg-background">
  <div class="max-w-[1176px] mx-auto px-6 py-24">
    <div class="text-center mb-16">
      <p class="text-[#131313] font-normal mb-4">• Features</p>
      <h2 class="text-[60px] font-normal tracking-[-3.6px] leading-[1.1] max-w-[800px] mx-auto">
        Empowering and strengthening your financial success
      </h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-[#f3f4f2] p-8 rounded-[16px] flex flex-col justify-between items-start text-left">
        <img
          src="https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0dc4_Dashboard-one-image-one-320.webp"
          alt="Intuitive user interface"
          class="w-full object-cover rounded-[12px] mb-8"
        />
        <div>
          <h3 class="text-[24px] font-normal leading-[1.2] text-foreground mb-3">Intuitive user interface</h3>
          <p class="text-[16px] text-[#4e4e4e] leading-[1.5]">
            User-friendly design for effortless navigation and usability
          </p>
        </div>
      </div>
      <div class="bg-[#f3f4f2] p-8 rounded-[16px] flex flex-col justify-between items-start text-left">
        <img
          src="https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0dc5_Dashboard-one-image-two-320.webp"
          alt="Automated processes"
          class="w-full object-cover rounded-[12px] mb-8"
        />
        <div>
          <h3 class="text-[24px] font-normal leading-[1.2] text-foreground mb-3">Automated processes</h3>
          <p class="text-[16px] text-[#4e4e4e] leading-[1.5]">
            Streamlined workflows to increase efficiency and reduce manual tasks
          </p>
        </div>
      </div>
      <div class="bg-[#f3f4f2] p-8 rounded-[16px] flex flex-col justify-between items-start text-left">
        <img
          src="https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0dc6_Dashboard-one-image-three-320.webp"
          alt="Advanced security features"
          class="w-full object-cover rounded-[12px] mb-8"
        />
        <div>
          <h3 class="text-[24px] font-normal leading-[1.2] text-foreground mb-3">Advanced security features</h3>
          <p class="text-[16px] text-[#4e4e4e] leading-[1.5]">
            Protect your data with top-notch security protocols
          </p>
        </div>
      </div>
      <div class="bg-[#f3f4f2] p-8 rounded-[16px] flex flex-col justify-between items-start text-left">
        <img
          src="https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0dc9_Dashboard-one-image-sixe-320.webp"
          alt="Secure transactions"
          class="w-full object-cover rounded-[12px] mb-8"
        />
        <div>
          <h3 class="text-[24px] font-normal leading-[1.2] text-foreground mb-3">Secure transactions</h3>
          <p class="text-[16px] text-[#4e4e4e] leading-[1.5]">
            Safeguard your purchases with encrypted transactions and fraud detection
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
