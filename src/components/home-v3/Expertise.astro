<section id="expertise" class="bg-background">
  <div class="max-w-[1176px] mx-auto px-6 py-24">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-[80px] items-center">
      <div>
        <p class="text-[#131313] font-normal mb-4">• Expertise</p>
        <h2 class="text-[60px] font-normal tracking-[-3.6px] leading-[1.1] max-w-[500px] mb-8">
          Make payment easy, simplify your finance
        </h2>
        <p class="text-[16px] text-[#4e4e4e] mb-8 leading-[1.5]">
          Focused on your unique needs, our team delivers solutions that blend deep industry knowledge.
        </p>
        <a
          href="https://clayo-syncflowai-schema.webflow.io/home/home-v3#"
          class="bg-[#131313] hover:bg-[#232323] text-white rounded-[12px] px-6 py-3 inline-block transition-colors"
        >
          Get Started
        </a>
        <div class="flex flex-col gap-6 mt-12">
          <div class="flex items-start gap-4 border-b border-border pb-6">
            <h3 class="text-[20px] font-normal text-foreground">Strategy development</h3>
            <p class="text-[16px] text-[#4e4e4e]">Crafting strategic plans that align with your goals.</p>
          </div>
          <div class="flex items-start gap-4 border-b border-border pb-6">
            <h3 class="text-[20px] font-normal text-foreground">Financial consulting</h3>
            <p class="text-[16px] text-[#4e4e4e]">Expert guidance to optimize your financial performance.</p>
          </div>
          <div class="flex items-start gap-4 border-b border-border pb-6">
            <h3 class="text-[20px] font-normal text-foreground">Technology solutions</h3>
            <p class="text-[16px] text-[#4e4e4e]">Innovative tech strategies to enhance operational efficiency.</p>
          </div>
          <div class="flex items-start gap-4 border-b border-border pb-6">
            <h3 class="text-[20px] font-normal text-foreground">Risk Management</h3>
            <p class="text-[16px] text-[#4e4e4e]">Identify, assess, and mitigate risks to protect your assets</p>
          </div>
        </div>
      </div>
      <div class="bg-[#f3f4f2] rounded-[24px] p-10 flex items-center justify-center min-h-[600px]">
        <img
          src="https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0dc7_Dashboard-one-image-four-211.webp"
          alt="Expertise"
          class="w-full object-cover rounded-[16px]"
        />
      </div>
    </div>
  </div>
</section>
