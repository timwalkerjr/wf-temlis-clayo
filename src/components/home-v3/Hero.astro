---
<section id="hero" class="bg-background">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-[64px] items-center max-w-[1176px] mx-auto px-6 py-20">
    <div class="lg:col-span-6 flex flex-col">
      <h1 class="text-[68px] leading-[1.1] tracking-[-4.08px] font-normal text-[#131313]">
        Build &amp; growth with scalable tools
      </h1>
      <p class="text-[16px] text-[#4e4e4e] mt-4 mb-8 max-w-[480px] leading-[1.5]">
        Easily adapt to changes and scale your operations with our flexible infrastructure, designed to support your business growth.
      </p>
      <a
        href="https://www.temlis.com/"
        class="bg-[#131313] hover:bg-[#232323] text-white rounded-[12px] px-6 py-3 self-start transition-colors"
      >
        Get Started
      </a>
    </div>
    <div class="lg:col-span-6">
      <div class="relative rounded-[24px] overflow-hidden">
        <img
          src="https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0de4_Hero-three-main-image-320.webp"
          alt="Build & growth with scalable tools"
          class="w-full object-cover"
        />
        <div class="absolute bottom-6 left-6 bg-white p-6 rounded-[20px] shadow-lg w-[240px]">
          <p class="text-[14px] text-[#4e4e4e] mb-2">Total balance</p>
          <img
            src="https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0dc2_hero-one-balance-320.webp"
            alt="Balance chart"
            class="w-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>
