---
const { image = "https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0d01_Blog-one-main-image-320.webp", title = "The Ultimate Guide to Budgeting in 2024" } = Astro.props;
---
<section id="blog-post-hero" class="bg-background">
  <div class="max-w-[1176px] mx-auto px-6 py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-[64px] items-center">
      <div class="lg:col-span-7 flex flex-col">
        <div class="text-[16px] font-medium uppercase tracking-wider text-[#4e4e4e] mb-4">• Blog</div>
        <h1 class="text-[68px] font-normal tracking-[-4.08px] leading-[1.1] text-[#131313]">{title}</h1>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-[24px] overflow-hidden bg-[#f3f4f2]">
          <img src={image} alt={title} class="w-full h-auto object-cover" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>
