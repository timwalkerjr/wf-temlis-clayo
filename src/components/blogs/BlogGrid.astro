---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<section id="blog-grid" class="bg-background">
  <div class="max-w-[1176px] mx-auto px-6 py-24">
    <div class="text-center mb-16">
      <div class="text-[16px] font-medium uppercase tracking-wider text-[#4e4e4e] mb-4">• Blog and articles</div>
      <h1 class="text-[68px] font-normal tracking-[-4.08px] leading-[1.1] text-[#131313]">Latest insights and trends</h1>
      <p class="text-[16px] text-[#4e4e4e] max-w-[600px] mx-auto mt-6">Stay informed with expert insights on budgeting, investing, and financial planning.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <a href={`/articles/${post.id}/`} class="flex flex-col gap-4 text-left hover-lift">
          <div class="rounded-[16px] overflow-hidden bg-[#f3f4f2] aspect-video">
            {post.data.image ? (
              <img
                src={post.data.image}
                alt={post.data.title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full bg-[#f3f4f2]" aria-hidden="true"></div>
            )}
          </div>
          <div class="flex items-center gap-2">
            {(post.data.tags ?? ['Insights']).map((tag) => (
              <span class="text-[12px] px-3 py-1 rounded-full bg-[#f3f4f2] text-[#4e4e4e]">{tag}</span>
            ))}
          </div>
          <h3 class="text-[24px] font-normal leading-[1.2] text-[#131313]">{post.data.title}</h3>
          <p class="text-[16px] text-[#4e4e4e]">{post.data.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>
