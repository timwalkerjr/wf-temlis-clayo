---
---
<section id="expertise-cards" class="bg-background">
  <div class="max-w-[1176px] mx-auto px-6 py-24 text-center">
    <div class="text-[#131313] font-normal mb-4">• Expertise</div>
    <h2 class="text-[60px] font-normal tracking-[-3.6px] leading-[1.1] max-w-[800px] mx-auto">Empowering and strengthening your financial success</h2>
    <p class="text-[16px] text-[#4e4e4e] max-w-[550px] mx-auto mt-4 mb-16">Our platform provides advanced tools and insights to help you manage, grow, and secure your financial assets.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-left">
      <!-- Card 1 -->
      <div class="bg-[#f3f4f2] p-8 rounded-[16px] flex flex-col justify-between items-start min-h-[400px]">
        <img
          src="https://cdn.prod.website-files.com/6a3c3ed1c7bf81e0610b0b6a/6a3c3ed5c7bf81e0610b0dfd_Finance%20image%20four.webp"
          alt="Interface"
          class="w-full h-auto object-cover rounded-[12px] mb-6"
        />
        <div>
          <h3 class="text-[24px] font-normal leading-[1.2] text-[#131313] mb-3">Intuitive user interface</h3>
          <p class="text-[16px] text-[#4e4e4e] mb-4">User-friendly design for effortless navigation and usability</p>
          <a href="/features" class="inline-flex items-center gap-2 text-[16px] font-medium text-[#131313] hover:text-[#5F58FF] transition-colors">Learn more
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="bg-[#f3f4f2] p-8 rounded-[16px] flex flex-col justify-between items-start min-h-[400px]">
        <img
          src="https://cdn.prod.website-files.com/6a3c3ed1c7bf81e0610b0b6a/6a3c3ed5c7bf81e0610b0dc4_Dashboard%20one%20-%20image%20one.webp"
          alt="Processes"
          class="w-full h-auto object-cover rounded-[12px] mb-6"
        />
        <div>
          <h3 class="text-[24px] font-normal leading-[1.2] text-[#131313] mb-3">Automated processes</h3>
          <p class="text-[16px] text-[#4e4e4e] mb-4">Streamlined workflows to increase efficiency and reduce manual tasks</p>
          <a href="/features" class="inline-flex items-center gap-2 text-[16px] font-medium text-[#131313] hover:text-[#5F58FF] transition-colors">Learn more
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="bg-[#f3f4f2] p-8 rounded-[16px] flex flex-col justify-between items-start min-h-[400px]">
        <img
          src="https://cdn.prod.website-files.com/6a3c3ed1c7bf81e0610b0b6a/6a3c3ed5c7bf81e0610b0dc5_Dashboard%20one%20-%20image%20two.webp"
          alt="Security"
          class="w-full h-auto object-cover rounded-[12px] mb-6"
        />
        <div>
          <h3 class="text-[24px] font-normal leading-[1.2] text-[#131313] mb-3">Advanced security features</h3>
          <p class="text-[16px] text-[#4e4e4e] mb-4">Protect your data with top-notch security protocols</p>
          <a href="/features" class="inline-flex items-center gap-2 text-[16px] font-medium text-[#131313] hover:text-[#5F58FF] transition-colors">Learn more
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="bg-[#f3f4f2] p-8 rounded-[16px] flex flex-col justify-between items-start min-h-[400px]">
        <img
          src="https://cdn.prod.website-files.com/6a3c3ed1c7bf81e0610b0b6a/6a3c3ed5c7bf81e0610b0dc6_Dashboard%20one%20-%20image%20three.webp"
          alt="Transactions"
          class="w-full h-auto object-cover rounded-[12px] mb-6"
        />
        <div>
          <h3 class="text-[24px] font-normal leading-[1.2] text-[#131313] mb-3">Secure transactions</h3>
          <p class="text-[16px] text-[#4e4e4e] mb-4">Safeguard your purchases with encrypted transactions and fraud detection</p>
          <a href="/features" class="inline-flex items-center gap-2 text-[16px] font-medium text-[#131313] hover:text-[#5F58FF] transition-colors">Learn more
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>

    <a href="/features" class="bg-[#131313] text-white px-6 py-3 rounded-[12px] inline-block mt-12 hover:bg-[#232323] transition-colors">Learn more</a>
  </div>
</section>
