---
<section id="features-hero" class="bg-background">
  <div class="max-w-[1176px] mx-auto px-6 py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-[64px] items-center">
      <!-- Left: Text content -->
      <div class="lg:col-span-6 flex flex-col">
        <h1 class="text-[68px] leading-[1.1] tracking-[-4.08px] font-normal text-[#131313]">Core features that empower your business</h1>
        <p class="text-[16px] text-[#4e4e4e] mt-4 mb-8 max-w-[480px]">Explore our comprehensive suite of tools designed to streamline operations, secure transactions, and deliver actionable insights in real-time.</p>
        <a href="#about-clayo" class="bg-[#131313] hover:bg-[#232323] text-white rounded-[12px] px-6 py-3 self-start transition-colors">Learn more</a>
      </div>
      <!-- Right: Hero image -->
      <div class="lg:col-span-6">
        <div class="relative rounded-[24px] overflow-hidden">
          <img
            src="https://cdn.prod.website-files.com/6a3c3ed1c7bf81e0610b0b6a/6a3c3ed5c7bf81e0610b0de7_Features%20-%20hero%20main%20image.webp"
            alt="Features hero"
            class="w-full h-auto object-cover"
          />
          <div class="absolute bottom-6 right-6 w-[200px] bg-white p-4 rounded-[16px] shadow-lg">
            <img
              src="https://cdn.prod.website-files.com/6a3c3ed1c7bf81e0610b0b6a/6a3c3ed5c7bf81e0610b0dc9_Dashboard%20one%20-%20image%20sixe.webp"
              alt="Dashboard preview"
              class="w-full h-auto object-cover rounded-[8px]"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
