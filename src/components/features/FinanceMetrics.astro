---
---
<section id="finance-metrics" class="bg-background">
  <div class="max-w-[1176px] mx-auto px-6 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] gap-[64px] items-center">
      <!-- Left: Image -->
      <div class="rounded-[20px] overflow-hidden">
        <img
          src="https://cdn.prod.website-files.com/6a3c3ed1c7bf81e0610b0b6a/6a3c3ed5c7bf81e0610b0dfa_Finance%20image%20three.webp"
          alt="Finance"
          class="w-full h-auto object-cover"
        />
      </div>
      <!-- Right: Stats text -->
      <div class="flex flex-col gap-8">
        <h3 class="text-[36px] font-normal leading-[1.2] tracking-[-2.16px] text-[#131313]">Complete customer satisfaction through tailored solutions and a commitment to excellence.</h3>
        <div class="flex flex-col gap-2">
          <span class="text-[48px] font-normal tracking-[-2.88px] text-[#5F58FF]">95%</span>
          <span class="text-[16px] text-[#4e4e4e]">Customer satisfaction rate</span>
        </div>
        <div class="flex flex-col gap-2">
          <span class="text-[48px] font-normal tracking-[-2.88px] text-[#131313]">10+</span>
          <span class="text-[16px] text-[#4e4e4e]">Years of innovation and valuable insights, empowering businesses to thrive in a competitive market.</span>
        </div>
      </div>
    </div>
  </div>
</section>
