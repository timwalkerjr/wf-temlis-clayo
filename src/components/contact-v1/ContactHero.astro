---
---
<section id="contact-hero" class="bg-background">
  <div class="max-w-[1176px] mx-auto px-6 py-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-[80px] items-start">
      <!-- Left: Contact Info -->
      <div class="flex flex-col gap-10">
        <h1 class="text-[68px] leading-[1.1] tracking-[-4.08px] font-normal text-[#131313]">Get in touch</h1>

        <div class="flex flex-col gap-8">
          <div>
            <p class="text-[16px] text-[#4e4e4e] mb-2">Email:</p>
            <a href="mailto:Moneta@gmail.com" class="text-[24px] font-normal text-[#131313] hover:text-[#5F58FF] transition-colors">Moneta@gmail.com</a>
          </div>

          <div>
            <p class="text-[16px] text-[#4e4e4e] mb-2">Phone:</p>
            <a href="tel:+17631683" class="text-[24px] font-normal text-[#131313] hover:text-[#5F58FF] transition-colors">+17631683</a>
          </div>

          <div>
            <p class="text-[16px] text-[#4e4e4e] mb-2">Address:</p>
            <p class="text-[24px] font-normal text-[#131313] leading-[1.3]">123 Innovation Avenue, Suite 456<br/>Tech District, San Francisco, CA 94107<br/>United States</p>
          </div>
        </div>

        <div>
          <p class="text-[16px] text-[#4e4e4e] mb-4">Follow us</p>
          <div class="flex items-center gap-3">
            <a href="#" aria-label="Instagram" class="w-12 h-12 rounded-full bg-[#f3f4f2] flex items-center justify-center hover:bg-[#5F58FF] hover:text-white transition-colors text-[#131313]">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            </a>
            <a href="#" aria-label="Facebook" class="w-12 h-12 rounded-full bg-[#f3f4f2] flex items-center justify-center hover:bg-[#5F58FF] hover:text-white transition-colors text-[#131313]">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="#" aria-label="LinkedIn" class="w-12 h-12 rounded-full bg-[#f3f4f2] flex items-center justify-center hover:bg-[#5F58FF] hover:text-white transition-colors text-[#131313]">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="#" aria-label="X" class="w-12 h-12 rounded-full bg-[#f3f4f2] flex items-center justify-center hover:bg-[#5F58FF] hover:text-white transition-colors text-[#131313]">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Form -->
      <div class="bg-[#f3f4f2] rounded-[24px] p-10">
        <form class="flex flex-col gap-6" data-ps="contact-v1-form">
          <div class="flex flex-col gap-2">
            <label for="contact-v1-name" class="text-[14px] font-medium text-[#131313]">Your Name</label>
            <input type="text" id="contact-v1-name" name="name" placeholder="" class="bg-white border border-[#d4d4d4] rounded-[12px] px-5 py-4 text-[16px] text-[#131313] focus:outline-none focus:border-[#5F58FF] transition-colors" />
          </div>
          <div class="flex flex-col gap-2">
            <label for="contact-v1-email" class="text-[14px] font-medium text-[#131313]">Email address</label>
            <input type="email" id="contact-v1-email" name="email" placeholder="" class="bg-white border border-[#d4d4d4] rounded-[12px] px-5 py-4 text-[16px] text-[#131313] focus:outline-none focus:border-[#5F58FF] transition-colors" />
          </div>
          <div class="flex flex-col gap-2">
            <label for="contact-v1-message" class="text-[14px] font-medium text-[#131313]">Message</label>
            <textarea id="contact-v1-message" name="message" rows="6" placeholder="" class="bg-white border border-[#d4d4d4] rounded-[12px] px-5 py-4 text-[16px] text-[#131313] resize-none focus:outline-none focus:border-[#5F58FF] transition-colors"></textarea>
          </div>
          <button type="submit" class="bg-[#131313] hover:bg-[#232323] text-white rounded-[12px] px-6 py-4 text-[16px] font-medium transition-colors self-start">Send Message</button>
          <div class="text-[14px] text-[#4e4e4e] success-msg hidden">Thank you! Your submission has been received!</div>
          <div class="text-[14px] text-[#ff4d4d] error-msg hidden">Oops! Something went wrong while submitting the form.</div>
        </form>
      </div>
    </div>
  </div>
</section>
