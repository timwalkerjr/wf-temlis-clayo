---
---
<section id="contact-hero" class="bg-background">
  <div class="max-w-[1176px] mx-auto px-6 py-24">
    <div class="flex flex-col items-center text-center gap-6 mb-16">
      <h1 class="text-[68px] leading-[1.1] tracking-[-4.08px] font-normal text-[#131313]">Get in touch</h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-[80px] items-start">
      <!-- Left: Contact Info -->
      <div class="flex flex-col gap-10">
        <div class="flex flex-col gap-8">
          <div>
            <p class="text-[16px] text-[#4e4e4e] mb-2">Email:</p>
            <a href="mailto:Moneta@gmail.com" class="text-[24px] font-normal text-[#131313] hover:text-[#5F58FF] transition-colors">Moneta@gmail.com</a>
          </div>

          <div>
            <p class="text-[16px] text-[#4e4e4e] mb-2">Phone:</p>
            <a href="tel:+17631683" class="text-[24px] font-normal text-[#131313] hover:text-[#5F58FF] transition-colors">+17631683</a>
          </div>

          <div>
            <p class="text-[16px] text-[#4e4e4e] mb-2">Address:</p>
            <p class="text-[24px] font-normal text-[#131313] leading-[1.3]">123 Innovation Avenue, Suite 456<br/>Tech District, San Francisco, CA 94107<br/>United States</p>
          </div>
        </div>
      </div>

      <!-- Right: Form -->
      <div class="bg-[#f3f4f2] rounded-[24px] p-10">
        <form class="flex flex-col gap-6" data-ps="contact-v2-form">
          <div class="flex flex-col gap-2">
            <label for="contact-v2-name" class="text-[14px] font-medium text-[#131313]">Name</label>
            <input type="text" id="contact-v2-name" name="name" placeholder="" class="bg-white border border-[#d4d4d4] rounded-[12px] px-5 py-4 text-[16px] text-[#131313] focus:outline-none focus:border-[#5F58FF] transition-colors" />
          </div>
          <div class="flex flex-col gap-2">
            <label for="contact-v2-email" class="text-[14px] font-medium text-[#131313]">Email address</label>
            <input type="email" id="contact-v2-email" name="email" placeholder="" class="bg-white border border-[#d4d4d4] rounded-[12px] px-5 py-4 text-[16px] text-[#131313] focus:outline-none focus:border-[#5F58FF] transition-colors" />
          </div>
          <div class="flex flex-col gap-2">
            <label for="contact-v2-email2" class="text-[14px] font-medium text-[#131313]">Email address</label>
            <input type="email" id="contact-v2-email2" name="email-confirm" placeholder="" class="bg-white border border-[#d4d4d4] rounded-[12px] px-5 py-4 text-[16px] text-[#131313] focus:outline-none focus:border-[#5F58FF] transition-colors" />
          </div>
          <button type="submit" class="bg-[#131313] hover:bg-[#232323] text-white rounded-[12px] px-6 py-4 text-[16px] font-medium transition-colors self-start">Send Message</button>
          <div class="text-[14px] text-[#4e4e4e] success-msg hidden">Thank you! Your submission has been received!</div>
          <div class="text-[14px] text-[#ff4d4d] error-msg hidden">Oops! Something went wrong while submitting the form.</div>
        </form>
      </div>
    </div>
  </div>
</section>
