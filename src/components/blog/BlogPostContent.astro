---
import Container from '@/components/Container.astro';

export interface Props {
  intro: string;
  sections: { title: string; body: string }[];
}

const { intro, sections } = Astro.props;
---

<section class="bg-background py-12" data-ps="src/components/blog/BlogPostContent.astro:1a2b3c">
  <Container class="max-w-[900px]">
    <div class="prose prose-lg max-w-none" data-ps="src/components/blog/BlogPostContent.astro:2c3d4e">
      <p class="text-[18px] leading-[1.7] text-[#131313] mb-12" data-ps="src/components/blog/BlogPostContent.astro:3d4e5f">
        {intro}
      </p>

      <p class="text-[18px] leading-[1.7] text-[#131313] mb-8" data-ps="src/components/blog/BlogPostContent.astro:4e5f6g">
        Here's what you need to know:
      </p>

      {sections.map((section) => (
        <div class="mb-10" data-ps="src/components/blog/BlogPostContent.astro:5f6g7h">
          <h3 class="text-[24px] font-normal leading-[1.3] tracking-[-1.44px] text-[#131313] mt-10 mb-4" data-ps="src/components/blog/BlogPostContent.astro:6g7h8i">
            {section.title}
          </h3>
          <p class="text-[18px] leading-[1.7] text-[#4e4e4e]" data-ps="src/components/blog/BlogPostContent.astro:7h8i9j">
            {section.body}
          </p>
        </div>
      ))}
    </div>
  </Container>
</section>
