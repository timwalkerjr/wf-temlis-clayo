---
import Container from '@/components/Container.astro';

export interface Props {
  tags: string[];
  author: {
    name: string;
    role: string;
    avatar: string;
  };
}

const { tags, author } = Astro.props;
---

<section class="bg-background py-12 border-t border-border" data-ps="src/components/blog/BlogAuthor.astro:1a2b3c">
  <Container class="max-w-[900px]">
    <div class="flex flex-col gap-6" data-ps="src/components/blog/BlogAuthor.astro:2c3d4e">
      <div class="flex flex-col gap-2" data-ps="src/components/blog/BlogAuthor.astro:3d4e5f">
        <span class="text-[14px] text-[#4e4e4e] uppercase tracking-wider font-medium" data-ps="src/components/blog/BlogAuthor.astro:4e5f6g">Category</span>
        <div class="flex gap-2" data-ps="src/components/blog/BlogAuthor.astro:5f6g7h">
          {tags.map((tag) => (
            <span class="px-3 py-1 bg-[#f3f4f2] rounded-full text-[12px] font-medium text-[#4e4e4e] uppercase tracking-wider" data-ps="src/components/blog/BlogAuthor.astro:6g7h8i">{tag}</span>
          ))}
        </div>
      </div>

      <div class="flex flex-col gap-4 mt-4" data-ps="src/components/blog/BlogAuthor.astro:7h8i9j">
        <span class="text-[14px] text-[#4e4e4e] uppercase tracking-wider font-medium" data-ps="src/components/blog/BlogAuthor.astro:8i9j0k">Written by</span>
        <div class="flex items-center gap-4" data-ps="src/components/blog/BlogAuthor.astro:9j0k1l">
          <div class="w-14 h-14 rounded-full overflow-hidden bg-surface" data-ps="src/components/blog/BlogAuthor.astro:0k1l2m">
            <img src={author.avatar} alt={author.name} class="w-full h-full object-cover" data-ps="src/components/blog/BlogAuthor.astro:1l2m3n" />
          </div>
          <div class="flex flex-col" data-ps="src/components/blog/BlogAuthor.astro:2m3n4o">
            <span class="text-[16px] font-medium text-[#131313]" data-ps="src/components/blog/BlogAuthor.astro:3n4o5p">{author.name}</span>
            <span class="text-[14px] text-[#4e4e4e]" data-ps="src/components/blog/BlogAuthor.astro:4o5p6q">{author.role}</span>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
