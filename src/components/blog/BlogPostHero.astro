---
import Container from '@/components/Container.astro';

export interface Props {
  image: string;
  alt: string;
}

const { image, alt } = Astro.props;
---

<section class="bg-background pt-12 pb-12" data-ps="src/components/blog/BlogPostHero.astro:7y2z1a">
  <Container class="max-w-[1176px]">
    <div class="rounded-[24px] overflow-hidden aspect-[2.4] bg-surface" data-ps="src/components/blog/BlogPostHero.astro:8m3q4r">
      <img
        src={image}
        alt={alt}
        class="w-full h-full object-cover"
        data-ps="src/components/blog/BlogPostHero.astro:9k5s6t"
      />
    </div>
  </Container>
</section>
