---
import Container from '@/components/Container.astro';

export interface RelatedPost {
  title: string;
  excerpt: string;
  image: string;
  tags: string[];
  href: string;
}

export interface Props {
  posts: RelatedPost[];
}

const { posts } = Astro.props;
---

<section class="bg-background py-20 border-t border-border" data-ps="src/components/blog/BlogRelatedPosts.astro:1a2b3c">
  <Container class="max-w-[1176px]">
    <div class="flex flex-col gap-2 mb-12" data-ps="src/components/blog/BlogRelatedPosts.astro:2c3d4e">
      <div class="flex items-center gap-2 text-[16px] font-normal text-[#131313]" data-ps="src/components/blog/BlogRelatedPosts.astro:3d4e5f">
        <span class="w-2 h-2 rounded-full bg-[#131313]" data-ps="src/components/blog/BlogRelatedPosts.astro:4e5f6g"></span>
        Related articles
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-ps="src/components/blog/BlogRelatedPosts.astro:5f6g7h">
      {posts.map(post => (
        <a href={post.href} class="flex flex-col gap-4 no-underline group" data-ps="src/components/blog/BlogRelatedPosts.astro:6g7h8i">
          <div class="aspect-[1.5] rounded-[20px] overflow-hidden bg-surface" data-ps="src/components/blog/BlogRelatedPosts.astro:7h8i9j">
            <img src={post.image} alt={post.title} class="w-full h-full object-cover transition-transform group-hover:scale-105" data-ps="src/components/blog/BlogRelatedPosts.astro:8i9j0k" />
          </div>
          <div class="flex flex-col gap-4" data-ps="src/components/blog/BlogRelatedPosts.astro:9j0k1l">
            <div class="flex gap-2" data-ps="src/components/blog/BlogRelatedPosts.astro:0k1l2m">
              {post.tags.map(tag => (
                <span class="px-3 py-1 bg-[#f3f4f2] rounded-full text-[12px] font-medium text-[#4e4e4e] uppercase tracking-wider" data-ps="src/components/blog/BlogRelatedPosts.astro:1l2m3n">{tag}</span>
              ))}
            </div>
            <h3 class="text-[20px] font-normal leading-[1.3] text-[#131313] group-hover:text-secondary transition-colors" data-ps="src/components/blog/BlogRelatedPosts.astro:2m3n4o">
              {post.title}
            </h3>
            <p class="text-[14px] leading-[1.6] text-[#4e4e4e]" data-ps="src/components/blog/BlogRelatedPosts.astro:3n4o5p">
              {post.excerpt}
            </p>
          </div>
        </a>
      ))}
    </div>
  </Container>
</section>
