---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import AboutTagline from '@/components/home/AboutTagline.astro';
import FinanceGrid from '@/components/home/FinanceGrid.astro';
import Expertise from '@/components/home/Expertise.astro';
import FeaturesTabs from '@/components/home/FeaturesTabs.astro';
import Testimonials from '@/components/home/Testimonials.astro';
import Pricing from '@/components/home/Pricing.astro';
import BlogSlider from '@/components/home/BlogSlider.astro';
import { SITE } from '@/config/site';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": SITE.title,
  "description": SITE.description,
  "url": SITE.url
};
---

<BaseLayout title={SITE.title} description={SITE.description} jsonLd={jsonLd}>
  <Hero />
  <AboutTagline />
  <FinanceGrid />
  <Expertise />
  <FeaturesTabs />
  <Testimonials />
  <Pricing />
  <BlogSlider />
</BaseLayout>
