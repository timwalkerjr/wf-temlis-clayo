---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogPostHero from '@/components/blog/BlogPostHero.astro';
import BlogPostContent from '@/components/blog/BlogPostContent.astro';
import BlogAuthor from '@/components/blog/BlogAuthor.astro';
import BlogRelatedPosts from '@/components/blog/BlogRelatedPosts.astro';

const intro = "In today's interconnected economy, geopolitical shifts, health crises, and supply-chain disruptions can trigger swift market turbulence and alter consumer behavior. Preparing your finances for these shocks is key to maintaining stability when uncertainty strikes. Resilience planning has become paramount for modern investors.";

const sections = [
  {
    title: "Diversify Across Geographies and Sectors",
    body: "Investing in a global mix of regions and industries smooths out local downturns. International ETFs and multinational corporations provide ballast when one market underperforms."
  },
  {
    title: "Build an Emergency Cash Reserve",
    body: "Holding 3–6 months of living costs in liquid assets ensures you cover unexpected expenses without liquidating investments at a loss. A tiered cash strategy balances accessibility with modest returns."
  },
  {
    title: "Stay Informed and Adapt Your Strategy",
    body: "Track reliable news sources and economic indicators—interest rates, commodity prices, employment data—to anticipate shifts. Adjust allocations or savings rates in response to emerging risks."
  }
];

const relatedPosts = [
  {
    title: "The Ultimate Guide to Budgeting in 2024",
    excerpt: "Master the art of budgeting with our comprehensive guide. Learn how to create a budget that works for you.",
    image: "https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0d00_Blog-one-thumbnail-image-320.webp",
    tags: ["News", "Insights"],
    href: "/blogs/the-ultimate-guide-to-budgeting-in-2024"
  },
  {
    title: "Top Investment Strategies for Long-Term Growth",
    excerpt: "Discover the best investment strategies to build and sustain your wealth over time. From stocks to bonds.",
    image: "https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0d04_Blog-two-thumbnail-image-640.webp",
    tags: ["News", "Insights"],
    href: "/blogs/top-investment-strategies-for-long-term-growth"
  },
  {
    title: "Understanding Cryptocurrency: What You Need to Know",
    excerpt: "Cryptocurrency continues to make headlines, but what does it mean for your finances? Get a clear understanding of the risks.",
    image: "https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0d06_Blog-three-thumbnail-image-640.webp",
    tags: ["News", "Insights"],
    href: "/blogs/understanding-cryptocurrency-what-you-need-to-know"
  },
  {
    title: "How to Reduce Debt and Improve Your Credit Score",
    excerpt: "Discover actionable steps to pay down debt and boost your credit profile responsibly.",
    image: "https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0d09_Blog-four-thumbnail-image-640.webp",
    tags: ["News", "Insights"],
    href: "/blogs/how-to-reduce-debt-and-improve-your-credit-score"
  },
  {
    title: "Financial Planning for Entrepreneurs: A Success Blueprint",
    excerpt: "Running a business requires careful financial planning. Discover the key steps to managing your business finances.",
    image: "https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0d71_Blog-six-thumbnail-image-320.webp",
    tags: ["News", "Insights"],
    href: "/blogs/financial-planning-for-entrepreneurs-a-success-blueprint"
  }
];
---

<BaseLayout
  title="The Impact of Global Events on Your Finances - Webflow Ecommerce website template"
  description="Discover how global events affect your finances and learn strategies to safeguard wealth against geopolitical and economic shocks."
  image="https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0d2f_Blog-five-main-image-320.webp"
>
  <BlogPostHero
    image="https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0d2f_Blog-five-main-image-320.webp"
    alt="The Impact of Global Events on Your Finances"
  />
  <BlogPostContent intro={intro} sections={sections} />
  <BlogAuthor
    tags={["News", "Insights"]}
    author={{
      name: "Daniel Smith",
      role: "Economist, Global Financial Insights",
      avatar: "https://pagesmith-cdn.com/ededff4c/images/6a3c3ed5c7bf81e0610b0d50_Blog-five-author-image-144.webp"
    }}
  />
  <BlogRelatedPosts posts={relatedPosts} />
</BaseLayout>
